{
  "name": "@open-code-desk/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode Desk desktop application",
  "author": "OpenCode Desk Contributors",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:dir": "pnpm build && electron-builder --dir --config electron-builder.yml",
    "package:win": "pnpm build && electron-builder --win --config electron-builder.yml",
    "package:mac": "pnpm build && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "@open-code-desk/application": "workspace:*",
    "@open-code-desk/domain": "workspace:*",
    "@open-code-desk/ipc-contracts": "workspace:*",
    "@open-code-desk/provider-core": "workspace:*",
    "@open-code-desk/tool-core": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "node-pty": "^1.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.27.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.14"
  }
}
