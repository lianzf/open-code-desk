{
  "name": "open-code-desk",
  "version": "0.3.0-alpha.1",
  "private": true,
  "description": "A local-first, approval-driven AI coding desktop application.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.12.0 <26"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @open-code-desk/desktop dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "build": "pnpm -r --if-present build",
    "package:dir": "pnpm --filter @open-code-desk/desktop package:dir",
    "package:win": "pnpm --filter @open-code-desk/desktop package:win",
    "package:mac": "pnpm --filter @open-code-desk/desktop package:mac",
    "package:linux": "pnpm --filter @open-code-desk/desktop package:linux"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
